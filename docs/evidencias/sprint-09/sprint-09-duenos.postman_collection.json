{
  "info": {
    "name": "Sprint 09 - API de dueños hexagonal con MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "anaId",
      "value": ""
    },
    {
      "key": "luisId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Lista inicial vacía",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/duenos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sin due\\u00f1os\", () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Registrar Ana",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/duenos",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Ana\", \"apellido\": \"Gómez\", \"email\": \"ana@example.com\", \"telefono\": \"1112345678\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"anaId\", pm.response.json().id);",
              "pm.test(\"ID generado y Location\", () => { pm.expect(pm.response.json().id).to.be.above(0); pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/duenos/\" + pm.response.json().id); });",
              "pm.test(\"DTO de salida\", () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql([\"apellido\", \"email\", \"id\", \"nombre\", \"telefono\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar Ana",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/duenos/{{anaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Email registrado\", () => pm.expect(pm.response.json().email).to.eql(\"ana@example.com\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Registrar Luis",
      "request": {
        "method": "POST",
        "header": [
          {
