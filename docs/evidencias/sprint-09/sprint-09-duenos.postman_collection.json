            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"luisId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Listar ambos dueños",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/duenos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Dos due\\u00f1os\", () => pm.expect(pm.response.json().length).to.eql(2));"
            ]
          }
        }
      ]
    },
